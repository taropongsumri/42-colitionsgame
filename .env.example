# Copy to .env and adjust as needed.

# "dev" runs Vite + a separate Bun socket server.
# "prod" runs a single Bun process serving both HTTP and WebSocket.
MODE=dev
PORT=3000
VITE_ORIGIN=http://localhost:5173

# Leave empty to use the local JSON store (./data/store.json).
# Set a URI to use MongoDB with the four databases from the design doc.
MONGO_URI=

# Local JSON store location (ignored when MONGO_URI is set).
DATA_DIR=./data

# Change both of these before deploying.
ADMIN_PASSWORD=admin
SPECTATOR_KEY=spectate

# Optional; Discord notifications arrive in a later phase.
DISCORD_WEBHOOK_URL=
