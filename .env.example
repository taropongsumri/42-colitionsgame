# Copy to .env and adjust as needed.

# "dev" runs Vite + a separate Bun socket server.
# "prod" runs a single Bun process serving both HTTP and WebSocket.
MODE=dev
PORT=3000
VITE_ORIGIN=http://localhost:5173

# Leave empty to use the local JSON store (./data/store.json).
# Set a URI to use MongoDB with the four databases from the design doc.
MONGO_URI=

# Local JSON store location (ignored when MONGO_URI is set).
DATA_DIR=./data

# Change all three of these before deploying.
ADMIN_PASSWORD=admin
SPECTATOR_KEY=spectate
# Shared secret for /internal/* calls made by the web process.
# Leave empty in prod to disable those endpoints; set it when using admin controls.
INTERNAL_SECRET=dev-internal

# External https:// origin when behind a TLS reverse proxy (WebSocket origin check).
# Leave empty when clients load the page directly from this server.
PUBLIC_ORIGIN=

# Optional; important events only (start/end, rooms, boss, admin). ~30/minute.
DISCORD_WEBHOOK_URL=
